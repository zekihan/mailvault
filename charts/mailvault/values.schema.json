{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "configSecret": {
      "type": "string",
      "minLength": 1
    },
    "suspend": {
      "type": "boolean"
    },
    "initialized": {
      "type": "boolean"
    },
    "schedule": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0
    },
    "persistence": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteOncePod",
                  "ReadWriteMany",
                  "ReadOnlyMany"
                ]
              }
            }
          }
        },
        "backups": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteOncePod",
                  "ReadWriteMany",
                  "ReadOnlyMany"
                ]
              }
            }
          }
        }
      }
    },
    "proton": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "setup": {
          "type": "boolean"
        },
        "networkPolicy": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "tlsSecret": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteOncePod",
                  "ReadWriteMany",
                  "ReadOnlyMany"
                ]
              }
            }
          }
        }
      }
    }
  }
}
